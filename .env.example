APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Cairo

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Facebook Lead Ads → CRM webhook (routes/web.php: /webhooks/facebook/leads).
# Paste https://YOUR-DOMAIN/webhooks/facebook/leads into the ad's "Connect your
# CRM" integration and use FB_LEADS_VERIFY_TOKEN as the verify token.
#   - FB_LEADS_VERIFY_TOKEN: any secret string you also type into Facebook.
#   - FB_LEADS_PAGE_TOKEN:   page access token, so the webhook can pull the full
#                            lead fields (name/phone) from the Graph API.
#   - FB_APP_SECRET:         enables X-Hub-Signature-256 payload verification.
# ---------------------------------------------------------------------------
FB_LEADS_VERIFY_TOKEN=
FB_LEADS_PAGE_TOKEN=
FB_APP_SECRET=
FB_GRAPH_VERSION=v21.0

# CARTO basemap API key (client-side map tiles). Get one at carto.com.
CARTO_API_KEY=

# Firebase Cloud Messaging (FCM) Configuration
FCM_SERVER_KEY=
FCM_PROJECT_ID=
FCM_USE_LEGACY_API=

# Firebase Configuration (for Web Push Notifications)
FCM_SERVICE_ACCOUNT_PATH=
FCM_API_KEY=
FCM_AUTH_DOMAIN=
FCM_STORAGE_BUCKET=
FCM_MESSAGING_SENDER_ID=
FCM_APP_ID=
FCM_VAPID_KEY=

# ---------------------------------------------------------------------------
# Demo sandbox — a populated clinic any visitor can try without signing up.
# Disabled by default; with these unset the application behaves as before.
# Setup and usage: docs/demo-sandbox/RUNBOOK.md
# ---------------------------------------------------------------------------
DEMO_ENABLED=false
DEMO_DB_CONNECTION=demo
# Connection holding demo funnel records (sessions/surveys/activity). Default
# 'mysql' (local). On the MAIN system, to show reports written by a SEPARATE
# demo deployment, set this to a connection pointing at that deployment's DB.
DEMO_RECORDS_CONNECTION=mysql

# ---- Demo environment database ----
# Where demo users' data lives. Set these so the MAIN system can connect to the
# demo environment's database and show reports for demo users. Point them at the
# demo deployment (which may be a different host); if the demo DB is on this same
# server they can be left unset and fall back to the DB_* values.
# In production use a dedicated MySQL user with NO write access to production.
DEMO_DB_HOST=127.0.0.1
DEMO_DB_PORT=3306
DEMO_DB_DATABASE=rosheta_demo
DEMO_DB_USERNAME=root
DEMO_DB_PASSWORD=
# Optional single-string DSN, overrides the parts above when set:
# DEMO_DB_URL=
DEMO_PROD_WRITE_GUARD=true
DEMO_MAX_DURATION_MINUTES=240
DEMO_IDLE_TIMEOUT_MINUTES=45
DEMO_MAX_CONCURRENT_PER_IP=3
DEMO_MAX_STARTS_PER_IP_PER_DAY=10
DEMO_GLOBAL_MAX_ACTIVE=500
